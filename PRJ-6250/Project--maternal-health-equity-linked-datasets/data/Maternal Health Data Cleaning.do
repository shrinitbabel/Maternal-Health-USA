use "C:\Users\iwashbur\OneDrive - University of Oklahoma\1 Projects\Leremy Research Group\Maternal Health HCUP SV CENSUS RAW.dta",clear
compress // Trying to decrease size of dataset - already the smallest
describe // Looking at variable formats, specifically looking for strings.

**************************************************************************
*Replacing the missing values amoung the HCUP dataset
**************************************************************************
foreach var of varlist prg011 - prg029 { // Looping through varibles
	replace `var' = ".a" if `var' == "*" // Replacing Missing Value
	destring `var',replace // Change format from String to Numeric
}
*.a = missing in HCUP as supressed FIPS level data

**************************************************************************
*Replaceing the missing values amoung the SVI dataset
**************************************************************************
foreach var of varlist e_pov - rpl_themes { // Looping through varibles
	replace `var' = ".b" if `var' == "#N/A" // Replacing Missing Value
	destring `var',replace // Change format from String to Numeric
}
*.b = missing in SVI as state totals were not initially calculated

**************************************************************************
*Replaceing the missing values amoung the SVI dataset
**************************************************************************
foreach var of varlist p1_001n - s0101_c06_038m { // Looping varibles
	replace `var' = ".b" if `var' == "#N/A" // Replacing Missing Value
	replace `var' = ".c" if `var' == "(X)" // Replacing Missing Value
	replace `var' = ".d" if `var' == "*****" // Replacing Missing Value
	destring `var',replace // Change format from String to Numeric
}
*.b = missing in Census data as state totals were not initially calculated
/*.c = missing in Census Data as (X) means that the estimate is not 
	applicable or not available */
/*.d = missing in Census Data as ***** means that the estimate is 
	controlled and the margin of error is 0 */


describe // Verifying all variables are correct format (numeric or String)
label define missing .a "HCUP Supressed" .b "Not Calculated" ///
	.c "Estimate NA" .d "if 0"
label values prg011-s0101_c06_038m missing

**************************************************************************
*Matching Combined Data with GIS Time Data for all states
**************************************************************************
rename fips_code_full fips // Simplifing data key variable name
replace fips = substr(fips,2,2) if strlen(fips) == 3
 //Removing unneeded 0s before state FIPS code
label variable county "County Name" // Redo Variable Label
label variable fips "FIPS code for States and and Counties" 
 //Redo Variable Label
drop fipscode // Remove incorrect FIPS code from dataset

merge 1:1 fips using "C:\Users\iwashbur\OneDrive - University of Oklahoma\1 Projects\Leremy Research Group\Maternal Health GIS Time RAW FULL.dta"
 //Merge Oklahoma GIS time data with combined dataset
*All 77 counties matched
drop _merge // Dropping a variable that shows how the matching went
order fips county time0 time1 time2 time3 // Moving time variables to top



